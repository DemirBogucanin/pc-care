<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PCCare</RootNamespace>
    <AssemblyName>PC Care</AssemblyName>
    <ApplicationIcon>Assets\PCCare.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>PC Care</Product>
    <AssemblyTitle>PC Care</AssemblyTitle>
    <Description>PC Care - a safe, modern Windows optimization tool.</Description>
    <Authors>PC Care</Authors>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\PCCare.png" />
    <Resource Include="Assets\PCCare.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
