<Window x:Class="PCCare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:PCCare.Views"
        Title="PC Care"
        Width="1220"
        Height="800"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}"
        Icon="pack://application:,,,/Assets/PCCare.ico"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DashboardNavStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDashboardPage}" Value="True">
                    <Setter Property="Background" Value="#121F1B" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CleanerNavStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCleanerPage}" Value="True">
                    <Setter Property="Background" Value="#121F1B" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StartupNavStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStartupPage}" Value="True">
                    <Setter Property="Background" Value="#121F1B" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DriversNavStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDriversPage}" Value="True">
                    <Setter Property="Background" Value="#121F1B" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PerformanceNavStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPerformancePage}" Value="True">
                    <Setter Property="Background" Value="#121F1B" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DashboardTemplate">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate x:Key="CleanerTemplate">
            <views:CleanerView />
        </DataTemplate>
        <DataTemplate x:Key="StartupTemplate">
            <views:StartupView />
        </DataTemplate>
        <DataTemplate x:Key="DriversTemplate">
            <views:DriversView />
        </DataTemplate>
        <DataTemplate x:Key="PerformanceTemplate">
            <views:PerformanceView />
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="#1B2630" BorderThickness="1" Background="{StaticResource WindowBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#17212B"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="86" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="22,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="11" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/PCCare.png" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PC Care" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="SYSTEM OPTIMIZER" Style="{StaticResource CaptionText}"
                                       FontSize="9" Margin="1,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="WORKSPACE" Style="{StaticResource CaptionText}"
                                   Margin="29,0,0,10" FontSize="9" />

                        <Button Tag="{Binding IsDashboardPage}" Command="{Binding NavigateCommand}"
                                CommandParameter="Dashboard" Style="{StaticResource DashboardNavStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE80F;" Style="{StaticResource IconText}" FontSize="17"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Grid.Column="1" Text="Dashboard" FontSize="13" FontWeight="SemiBold"
                                           Margin="11,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                        </Button>

                        <Button Tag="{Binding IsCleanerPage}" Command="{Binding NavigateCommand}"
                                CommandParameter="Cleaner" Style="{StaticResource CleanerNavStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="17"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Grid.Column="1" Text="Smart Cleaner" FontSize="13" FontWeight="SemiBold"
                                           Margin="11,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                        </Button>

                        <Button Tag="{Binding IsStartupPage}" Command="{Binding NavigateCommand}"
                                CommandParameter="Startup" Style="{StaticResource StartupNavStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" FontSize="17"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Grid.Column="1" Text="Startup Apps" FontSize="13" FontWeight="SemiBold"
                                           Margin="11,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                        </Button>

                        <Button Tag="{Binding IsDriversPage}" Command="{Binding NavigateCommand}"
                                CommandParameter="Drivers" Style="{StaticResource DriversNavStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7F8;" Style="{StaticResource IconText}" FontSize="17"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Grid.Column="1" Text="Drivers" FontSize="13" FontWeight="SemiBold"
                                           Margin="11,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                        </Button>

                        <Button Tag="{Binding IsPerformancePage}" Command="{Binding NavigateCommand}"
                                CommandParameter="Performance" Style="{StaticResource PerformanceNavStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" FontSize="17"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Grid.Column="1" Text="Performance" FontSize="13" FontWeight="SemiBold"
                                           Margin="11,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="18,0,18,20">
                        <Border Background="#101821" BorderBrush="#1D2A36" BorderThickness="1"
                                CornerRadius="12" Padding="12,11" Margin="0,0,0,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xEA18;" Style="{StaticResource IconText}"
                                           Foreground="{StaticResource AccentBrush}" FontSize="15" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding PrivilegeText}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="Protected operations enabled" Style="{StaticResource BodyText}"
                                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding AppVersion}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" FontWeight="Normal" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#0A1016">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Live monitoring" Style="{StaticResource CaptionText}"
                                       FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Style="{StaticResource WindowControlButton}"
                                ToolTip="Minimize">
                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="MaximizeButton" Click="MaximizeButton_Click" Style="{StaticResource WindowControlButton}"
                                ToolTip="Maximize">
                            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}"
                                       FontSize="10"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="CloseButton" Click="CloseButton_Click" Style="{StaticResource CloseButton}"
                                ToolTip="Close">
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource WindowGlow}">
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Setter Property="ContentTemplate" Value="{StaticResource DashboardTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Cleaner">
                                        <Setter Property="ContentTemplate" Value="{StaticResource CleanerTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Startup">
                                        <Setter Property="ContentTemplate" Value="{StaticResource StartupTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Drivers">
                                        <Setter Property="ContentTemplate" Value="{StaticResource DriversTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Performance">
                                        <Setter Property="ContentTemplate" Value="{StaticResource PerformanceTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Border>
            </Grid>

            <!-- Toast -->
            <Border Grid.Column="1" Panel.ZIndex="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,28,24" MaxWidth="470" CornerRadius="14" Background="#131E27"
                    BorderBrush="{Binding ToastAccentHex, Converter={StaticResource HexToBrush}}"
                    BorderThickness="1" Padding="14,12"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.35" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" CornerRadius="13" VerticalAlignment="Top" Margin="0,1,0,0"
                            Background="{Binding ToastAccentHex, Converter={StaticResource HexToBrush}}" Opacity="0.16" />
                    <TextBlock Grid.Column="0" Text="{Binding ToastGlyph}" Style="{StaticResource IconText}"
                               HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="14" Margin="0,6,0,0"
                               Foreground="{Binding ToastAccentHex, Converter={StaticResource HexToBrush}}" />
                    <TextBlock Grid.Column="1" Text="{Binding ToastMessage}" Style="{StaticResource BodyText}"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="9,0,4,0" FontSize="12.5"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
