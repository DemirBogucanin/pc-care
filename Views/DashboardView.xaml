<UserControl x:Class="PCCare.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCCare.Controls"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,24,36,34">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding TodayText}" Style="{StaticResource BodyText}" Margin="1,6,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource PillBorder}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="SYSTEM PROTECTED" Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource AccentBrush}" FontSize="9" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Hero -->
            <Border Margin="0,22,0,0" CornerRadius="22" BorderBrush="#233832" BorderThickness="1"
                    MinHeight="252">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#14241E" Offset="0" />
                        <GradientStop Color="#111A22" Offset="0.55" />
                        <GradientStop Color="#171723" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.18" Color="#000000" />
                </Border.Effect>
                <Grid ClipToBounds="True">
                    <Ellipse Width="380" Height="380" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-190,-210,0,0" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#2A3DDC97" Offset="0" />
                                <GradientStop Color="#003DDC97" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="280" Height="280" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-100,-150" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#1E6699FF" Offset="0" />
                                <GradientStop Color="#006699FF" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Grid Margin="28,24,26,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="218" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ONE-CLICK OPTIMIZATION" Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource AccentBrush}" FontSize="9" />
                            <TextBlock Text="Keep your PC feeling new." FontFamily="{StaticResource DisplayFont}"
                                       FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="Clean safe temporary files and free up space in one smooth pass."
                                       Style="{StaticResource BodyText}" MaxWidth="520" Margin="0,7,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding OptimizeCommand}"
                                        Width="176" Height="46">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{Binding OptimizeButtonText}" Margin="8,0,0,0" FontSize="13"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                                    <TextBlock Text="{Binding ReclaimableText}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Cleaner.LastCleanText}" Style="{StaticResource BodyText}"
                                               FontSize="10.5" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="0,20,0,0" MaxWidth="420" HorizontalAlignment="Left"
                                        Visibility="{Binding Cleaner.IsBusy, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <TextBlock Text="{Binding Cleaner.StatusText}" Style="{StaticResource BodyText}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Cleaner.LiveFreedText}" Style="{StaticResource CaptionText}"
                                               HorizontalAlignment="Right" FontSize="10"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Grid>
                                <ProgressBar Style="{StaticResource SlimProgressBar}" Height="7" Margin="0,8,0,0"
                                             Value="{Binding Cleaner.Progress, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Column="1" Width="184" Height="184" HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                            <controls:RingGauge Value="{Binding HealthScore}" StrokeThickness="12"
                                                ProgressBrush="{Binding HealthColorHex, Converter={StaticResource HexToBrush}}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HealthScoreText}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding HealthLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding HealthColorHex, Converter={StaticResource HexToBrush}}"
                                           HorizontalAlignment="Center" Margin="0,1,0,0" />
                                <TextBlock Text="SYSTEM HEALTH" Style="{StaticResource CaptionText}" FontSize="8"
                                           HorizontalAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Live metrics -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,0,10,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="#152333">
                                <TextBlock Text="&#xE950;" Style="{StaticResource IconText}" FontSize="16"
                                           Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="CPU LOAD" Style="{StaticResource CaptionText}"
                                       Margin="10,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding Performance.CpuPercentText}" Style="{StaticResource MetricValue}"
                                   FontSize="30" Margin="0,14,0,0" />
                        <ProgressBar Style="{StaticResource SlimProgressBar}" Height="6" Margin="0,10,0,0"
                                     Value="{Binding Performance.CpuPercent, Mode=OneWay}" Foreground="{StaticResource BlueBrush}" />
                        <TextBlock Text="{Binding Performance.CpuName}" Style="{StaticResource BodyText}"
                                   FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,9,0,0"
                                   ToolTip="{Binding Performance.CpuName}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20,18" Margin="5,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="#211C34">
                                <TextBlock Text="&#xE9F9;" Style="{StaticResource IconText}" FontSize="16"
                                           Foreground="#B795FF" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="MEMORY" Style="{StaticResource CaptionText}"
                                       Margin="10,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding Performance.RamPercentText}" Style="{StaticResource MetricValue}"
                                   FontSize="30" Margin="0,14,0,0" />
                        <ProgressBar Style="{StaticResource SlimProgressBar}" Height="6" Margin="0,10,0,0"
                                     Value="{Binding Performance.RamPercent, Mode=OneWay}" Foreground="#B795FF" />
                        <TextBlock Text="{Binding Performance.RamDetailText}" Style="{StaticResource BodyText}"
                                   FontSize="10.5" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20,18" Margin="10,0,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="#2A2218">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource IconText}" FontSize="16"
                                           Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="DISK USED" Style="{StaticResource CaptionText}"
                                       Margin="10,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding Performance.DiskPercentText}" Style="{StaticResource MetricValue}"
                                   FontSize="30" Margin="0,14,0,0" />
                        <ProgressBar Style="{StaticResource SlimProgressBar}" Height="6" Margin="0,10,0,0"
                                     Value="{Binding Performance.DiskPercent, Mode=OneWay}" Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="{Binding Performance.DiskDetailText}" Style="{StaticResource BodyText}"
                                   FontSize="10.5" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Storage and startup -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="22,20" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource IconText}" FontSize="16"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="Storage" Style="{StaticResource SectionTitle}" FontSize="16"
                                           Margin="9,0,0,0" />
                            </StackPanel>
                            <Button Content="Open cleaner" Style="{StaticResource GhostButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Cleaner"
                                    HorizontalAlignment="Right" />
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Performance.DiskFreeText}" Style="{StaticResource MetricValue}"
                                           FontSize="30" />
                                <TextBlock Text=" free on your system drive" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Bottom" Margin="7,0,0,5" />
                            </StackPanel>
                            <TextBlock Text="{Binding StorageSummaryText}" Style="{StaticResource BodyText}"
                                       Margin="0,4,0,0" FontSize="11" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,16,0,0">
                            <Grid>
                                <TextBlock Text="{Binding Performance.DiskPercentText}" Style="{StaticResource CaptionText}"
                                           FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding StorageFreePercentText}" Style="{StaticResource CaptionText}"
                                           FontSize="9" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                            <ProgressBar Style="{StaticResource SlimProgressBar}" Height="8" Margin="0,7,0,0"
                                         Value="{Binding Performance.DiskPercent, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="22,20" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" FontSize="16"
                                           Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="Startup apps" Style="{StaticResource SectionTitle}" FontSize="16"
                                           Margin="9,0,0,0" />
                            </StackPanel>
                            <Button Content="Manage" Style="{StaticResource GhostButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Startup"
                                    HorizontalAlignment="Right" />
                        </Grid>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Startup.EnabledCount}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="34" FontWeight="SemiBold" />
                                <TextBlock Text=" apps enabled" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Bottom" Margin="5,0,0,7" />
                            </StackPanel>
                            <TextBlock Text="{Binding StartupSummaryText}" Style="{StaticResource BodyText}"
                                       FontSize="11" Margin="0,5,0,0" />
                        </StackPanel>

                        <Border Grid.Row="2" Background="#101820" CornerRadius="9" Padding="11,9" Margin="0,12,0,0">
                            <TextBlock Text="Disable unused apps to sign in faster and reduce background load."
                                       Style="{StaticResource BodyText}" FontSize="10.5" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Margin="18,20,18,0">
                <TextBlock Text="&#xEA18;" Style="{StaticResource IconText}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                <TextBlock Text="Only known-safe locations are cleaned. Locked and in-use files are always skipped."
                           Style="{StaticResource BodyText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                           Margin="22,0,0,0" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
