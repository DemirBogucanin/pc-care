<UserControl x:Class="PCCare.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,24,36,34">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Smart Cleaner" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Remove unnecessary files from safe, well-known locations."
                               Style="{StaticResource BodyText}" Margin="1,6,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource PillBorder}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" FontSize="11"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="SAFE CLEANUP" Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource AccentBrush}" FontSize="9" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Summary -->
            <Border Style="{StaticResource CardStyle}" Margin="0,22,0,0" Padding="24,21">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="SELECTED FOR CLEANUP" Style="{StaticResource CaptionText}" FontSize="9" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Cleaner.SelectedSizeText}" Style="{StaticResource MetricValue}"
                                       FontSize="36" />
                            <TextBlock Text=" reclaimable" Style="{StaticResource BodyText}"
                                       VerticalAlignment="Bottom" Margin="7,0,0,7" />
                        </StackPanel>
                        <TextBlock Text="{Binding Cleaner.SelectedSummary}" Style="{StaticResource BodyText}"
                                   FontSize="11" Margin="1,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Scan again" Style="{StaticResource SecondaryButton}"
                                Command="{Binding Cleaner.ScanCommand}" Margin="0,0,10,0" MinWidth="116" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding Cleaner.CleanCommand}"
                                MinWidth="142" Height="44">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Clean now" Margin="8,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#1E2A35" BorderThickness="0,1,0,0"
                            Margin="0,18,0,0" Padding="0,15,0,0"
                            Visibility="{Binding Cleaner.IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding Cleaner.StatusText}" Style="{StaticResource BodyText}"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Cleaner.LiveFreedText}" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Right" FontSize="10"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                            <ProgressBar Style="{StaticResource SlimProgressBar}" Margin="0,9,0,0"
                                         Value="{Binding Cleaner.Progress, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Locations -->
            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0" Padding="0">
                <StackPanel>
                    <Grid Margin="24,18,18,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cleanup locations" Style="{StaticResource SectionTitle}" FontSize="16" />
                            <Border Background="#13231D" CornerRadius="10" Padding="7,3" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="ADMIN READY" Style="{StaticResource CaptionText}" FontSize="8"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Select all" Style="{StaticResource GhostButton}"
                                    Command="{Binding Cleaner.SelectAllCommand}" Margin="0,0,2,0" />
                            <Button Content="Clear" Style="{StaticResource GhostButton}"
                                    Command="{Binding Cleaner.ClearSelectionCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="#1B2732" BorderThickness="0,1,0,0">
                        <ItemsControl ItemsSource="{Binding Cleaner.Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#19242F" BorderThickness="0,0,0,1" Padding="24,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Style="{StaticResource CategoryCheckBox}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{Binding DataContext.Cleaner.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}"
                                                      VerticalAlignment="Center" />

                                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="11"
                                                    Background="#101820" BorderThickness="1"
                                                    BorderBrush="{Binding AccentHex, Converter={StaticResource HexToBrush}}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}"
                                                           FontSize="17" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding AccentHex, Converter={StaticResource HexToBrush}}" />
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,18,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}"
                                                           FontSize="10.5" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                                        HorizontalAlignment="Right" MinWidth="100">
                                                <TextBlock Text="{Binding SizeText}" FontSize="14" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding ItemCountText}" Style="{StaticResource BodyText}"
                                                           FontSize="10" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
                <Border Style="{StaticResource SubtleCardStyle}" Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="14"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Safety comes first" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Text="Files in use, protected system files, and personal folders are never touched. Every file stays recoverable until Windows removes it normally."
                                       Style="{StaticResource BodyText}" FontSize="10.5" Margin="0,3,0,0" MaxWidth="800" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Cleaner.LastCleanText}" Style="{StaticResource CaptionText}"
                                       FontSize="9" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding Cleaner.LastDeletedText}" Style="{StaticResource BodyText}"
                                       FontSize="10" HorizontalAlignment="Right" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
