<UserControl x:Class="PCCare.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,24,36,34">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Startup Apps" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Control what launches when Windows starts and keep sign-in fast."
                               Style="{StaticResource BodyText}" Margin="1,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" MinWidth="108"
                        Command="{Binding Startup.RefreshCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="Refresh" Margin="7,0,0,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="20,17" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="ENABLED" Style="{StaticResource CaptionText}" FontSize="9" />
                        <TextBlock Text="{Binding Startup.EnabledCountText}" Style="{StaticResource MetricValue}"
                                   FontSize="30" Margin="0,8,0,0" />
                        <TextBlock Text="apps start with Windows" Style="{StaticResource BodyText}"
                                   FontSize="10.5" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20,17" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL FOUND" Style="{StaticResource CaptionText}" FontSize="9" />
                        <TextBlock Text="{Binding Startup.TotalCountText}" Style="{StaticResource MetricValue}"
                                   FontSize="30" Margin="0,8,0,0" />
                        <TextBlock Text="registry and folder entries" Style="{StaticResource BodyText}"
                                   FontSize="10.5" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20,17" Margin="10,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="#13231D" VerticalAlignment="Top">
                            <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="15"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Reversible" Style="{StaticResource CardTitle}" FontSize="12" />
                            <TextBlock Text="Disabling an app never uninstalls it. Turn it back on anytime."
                                       Style="{StaticResource BodyText}" FontSize="10.5" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0" Padding="0">
                <StackPanel>
                    <Grid Margin="24,18,24,13">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Startup inventory" Style="{StaticResource SectionTitle}" FontSize="16" />
                            <Border Background="#15202B" CornerRadius="10" Padding="8,3" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Startup.SummaryText}" Style="{StaticResource CaptionText}"
                                           FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="STATUS" Style="{StaticResource CaptionText}" FontSize="8"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                    </Grid>

                    <Border BorderBrush="#1B2732" BorderThickness="0,1,0,0">
                        <ItemsControl ItemsSource="{Binding Startup.Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#19242F" BorderThickness="0,0,0,1" Padding="24,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="40" Height="40" CornerRadius="11" Background="#101820"
                                                    BorderThickness="1"
                                                    BorderBrush="{Binding AccentHex, Converter={StaticResource HexToBrush}}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{Binding AccentHex, Converter={StaticResource HexToBrush}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,20,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Command}" Style="{StaticResource BodyText}"
                                                           FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Command}" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource PillBorder}"
                                                    Padding="8,4" VerticalAlignment="Center" Margin="0,0,20,0">
                                                <TextBlock Text="{Binding Location}" Style="{StaticResource CaptionText}"
                                                           FontSize="8" FontWeight="Normal"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>

                                            <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      Command="{Binding DataContext.Startup.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"
                                                      IsEnabled="{Binding DataContext.Startup.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      ToolTip="Enable or disable this startup app" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Padding="30,42" Visibility="{Binding Startup.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="52" Height="52" CornerRadius="26" Background="#131D25">
                                <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" FontSize="21"
                                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No startup apps found" Style="{StaticResource SectionTitle}" FontSize="15"
                                       HorizontalAlignment="Center" Margin="0,13,0,0" />
                            <TextBlock Text="Your startup list is already clean." Style="{StaticResource BodyText}"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
                <Border Style="{StaticResource SubtleCardStyle}" Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="14"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="A note about startup apps" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Text="Disabling an entry only stops it from opening automatically at sign-in. The app stays installed and can be enabled again at any time."
                                       Style="{StaticResource BodyText}" FontSize="10.5" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
