<UserControl x:Class="PCCare.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCCare.Controls"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,24,36,34">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Performance" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="A live look at your processor, memory, and system drive."
                               Style="{StaticResource BodyText}" Margin="1,6,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource PillBorder}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="LIVE" Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource AccentBrush}" FontSize="9" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20,20" Margin="0,0,10,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="9" Background="#152333">
                                <TextBlock Text="&#xE950;" Style="{StaticResource IconText}" FontSize="15"
                                           Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Processor" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="CPU utilization" Style="{StaticResource CaptionText}" FontSize="8.5" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Width="156" Height="156" Margin="0,18,0,4" HorizontalAlignment="Center">
                            <controls:RingGauge Value="{Binding Performance.CpuPercent}" StrokeThickness="10"
                                                ProgressBrush="{StaticResource BlueBrush}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Performance.CpuPercentText}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="CPU" Style="{StaticResource CaptionText}" FontSize="8"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Performance.CpuDetailText}" Style="{StaticResource BodyText}"
                                   FontSize="10.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Performance.CpuName}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20,20" Margin="5,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="9" Background="#211C34">
                                <TextBlock Text="&#xE9F9;" Style="{StaticResource IconText}" FontSize="15"
                                           Foreground="#B795FF" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Memory" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="RAM pressure" Style="{StaticResource CaptionText}" FontSize="8.5" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Width="156" Height="156" Margin="0,18,0,4" HorizontalAlignment="Center">
                            <controls:RingGauge Value="{Binding Performance.RamPercent}" StrokeThickness="10"
                                                ProgressBrush="#B795FF" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Performance.RamPercentText}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="RAM" Style="{StaticResource CaptionText}" FontSize="8"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Performance.RamDetailText}" Style="{StaticResource BodyText}"
                                   FontSize="10.5" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20,20" Margin="10,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="9" Background="#2A2218">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource IconText}" FontSize="15"
                                           Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="System disk" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="Storage usage" Style="{StaticResource CaptionText}" FontSize="8.5" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Width="156" Height="156" Margin="0,18,0,4" HorizontalAlignment="Center">
                            <controls:RingGauge Value="{Binding Performance.DiskPercent}" StrokeThickness="10"
                                                ProgressBrush="{StaticResource WarningBrush}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Performance.DiskPercentText}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="USED" Style="{StaticResource CaptionText}" FontSize="8"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Performance.DiskDetailText}" Style="{StaticResource BodyText}"
                                   FontSize="10.5" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0" Padding="24,21">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="SYSTEM DETAILS" Style="{StaticResource CaptionText}" FontSize="9" />
                        <TextBlock Text="{Binding Performance.CpuName}" Style="{StaticResource SectionTitle}"
                                   FontSize="17" Margin="0,9,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Performance.OsName}" Style="{StaticResource BodyText}"
                                   FontSize="11" Margin="0,5,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Border Style="{StaticResource PillBorder}" Padding="9,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Performance.LogicalCoresText}" Style="{StaticResource CaptionText}"
                                           FontSize="8" FontWeight="Normal" />
                            </Border>
                            <Border Style="{StaticResource PillBorder}" Padding="9,4">
                                <TextBlock Text="{Binding Performance.UptimeText, StringFormat=Uptime {0}}"
                                           Style="{StaticResource CaptionText}" FontSize="8" FontWeight="Normal" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#1C2833" Width="1" Margin="0,3" />

                    <Grid Grid.Column="2" Margin="28,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="LIVE SNAPSHOT" Style="{StaticResource CaptionText}"
                                   FontSize="9" Margin="0,0,0,12" />

                        <TextBlock Grid.Row="1" Text="Memory in use" Style="{StaticResource BodyText}" FontSize="11" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Performance.RamDetailText}"
                                   FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="2" Text="Free disk space" Style="{StaticResource BodyText}"
                                   FontSize="11" Margin="0,11,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Performance.DiskFreeText}"
                                   FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,11,0,0" />

                        <TextBlock Grid.Row="3" Text="Disk capacity" Style="{StaticResource BodyText}"
                                   FontSize="11" Margin="0,11,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Performance.DiskTotalText}"
                                   FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,11,0,0" />
                    </Grid>
                </Grid>
            </Border>

            <TextBlock Text="Metrics refresh automatically every 1.5 seconds. No data leaves your computer."
                       Style="{StaticResource BodyText}" FontSize="10.5" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,17,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
